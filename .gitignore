# Generated by refresh.py
.refresh-state.json
refresh-report.txt

# Your own application history, in whichever format you keep it. refresh.py reads
# it and the page can import it. It is personal and this repository is public, so
# it must never be committed.
applications.json
applications.csv
applications.tsv
applications.xlsx

# Generated print artifacts
*.pdf
!samples/sample-resume-*.pdf
# The guide PDF is committed on purpose; regenerate it with ./make-guide-pdf.sh
!AI-Job-Finder-Guide.pdf

# Local Claude Code settings (may contain machine-specific permissions)
.claude/settings.local.json

# Python
__pycache__/
*.pyc
.venv/
venv/

# macOS
.DS_Store

# The job database refresh.py builds. It is rebuilt from the feeds, so it is not committed;
# jobs.json, the published slice the page reads, is.
jobs.db
jobs.db-journal

# Local preview settings: machine-specific paths
.claude/launch.json
